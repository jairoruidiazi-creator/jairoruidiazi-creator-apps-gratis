<?xml version="1.0" encoding="utf-8"?>
<!-- Temas de la actividad con el modo oscuro del sistema encendido. Heredan de
     Theme.AppCompat porque local_auth lo exige: en Android 7 a 8.1 la huella se
     pide con un diálogo de androidx.biometric que necesita atributos de
     AppCompat, y con el tema de la plantilla la app se cerraba al abrirlo. -->
<resources>
    <!-- Mientras arranca el proceso: el fondo con el ícono de la app. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Desde que arranca: el color de la ventana detrás de Flutter. -->
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
