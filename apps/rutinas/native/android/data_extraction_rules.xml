<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de Google y traspaso a un teléfono nuevo (Android 12 o superior).

  Viajan los datos (hábitos, recordatorios, entrenamientos) y los ajustes. No
  viajan la lista de avisos programados del plugin de notificaciones ni el
  registro de avisos de la app: las alarmas no se restauran con los datos, y
  esa lista diría que hay avisos programados cuando no los hay. Al abrir la
  app en el teléfono nuevo, Rutinas lo vuelve a programar todo. Tampoco
  viajan las copias exportadas, que ya se compartieron.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="rutinas/avisos.json" />
        <exclude domain="file" path="rutinas/exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="rutinas/avisos.json" />
        <exclude domain="file" path="rutinas/exports" />
    </device-transfer>
</data-extraction-rules>
