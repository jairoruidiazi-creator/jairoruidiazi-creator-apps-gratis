<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de Google hasta Android 11 (en Android 12 o superior manda
  data_extraction_rules.xml). Viajan los datos y los ajustes; no viajan la
  lista de avisos programados del plugin de notificaciones ni el registro de
  avisos (las alarmas no se restauran: la app las vuelve a programar al
  abrirla) ni las copias exportadas.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    <exclude domain="file" path="rutinas/avisos.json" />
    <exclude domain="file" path="rutinas/exports" />
</full-backup-content>
